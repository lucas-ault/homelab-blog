---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllTags } from "@/lib/content";
import { url } from "@/lib/utils";

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <div class="container-page py-10 sm:py-14">
    <header>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Tags</h1>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        {tags.length}
        {tags.length === 1 ? "topic" : "topics"} from the posts.
      </p>
    </header>

    <ul class="mt-8 divide-y divide-border/60 border-t border-border/60">
      {
        tags.map(({ tag, slug, count }) => (
          <li>
            <a
              href={url(`/tags/${slug}`)}
              class="group flex items-baseline justify-between gap-4 py-3 transition-colors"
            >
              <span class="font-mono text-sm text-foreground transition-colors group-hover:text-accent">
                <span class="text-accent/70">#</span>
                {tag}
              </span>
              <span class="shrink-0 text-xs text-muted-foreground">
                {count} {count === 1 ? "post" : "posts"}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
