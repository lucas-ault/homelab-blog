---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";

interface UsesItem {
  name: string;
  description: string;
  url?: string;
}

const sections: Array<{ title: string; items: UsesItem[] }> = [
  {
    title: "Homelab hardware",
    items: [
      {
        name: "Proxmox VE",
        description:
          "The hypervisor. VMs, LXCs, and the K3s nodes all live here.",
        url: "https://www.proxmox.com/en/proxmox-ve",
      },
      {
        name: "K3s nodes",
        description:
          "A small Kubernetes cluster for trying things I do not want to try at work.",
        url: "https://k3s.io",
      },
      {
        name: "TrueNAS",
        description: "Disks, backups, and the family photo pile.",
        url: "https://www.truenas.com",
      },
      {
        name: "Tailscale",
        description:
          "How I reach the lab from anywhere. MagicDNS and subnet routes do most of the work.",
        url: "https://tailscale.com",
      },
      {
        name: "Network gear",
        description:
          "Separate VLANs for the lab, IoT junk, and the stuff I actually care about.",
      },
    ],
  },
  {
    title: "Software & tooling",
    items: [
      {
        name: "Cursor",
        description: "Where I write scripts, infra, and this site.",
        url: "https://cursor.com",
      },
      {
        name: "GitLab",
        description: "CI at work, and the pipelines for the lab.",
        url: "https://gitlab.com",
      },
      {
        name: "Python",
        description:
          "What I reach for first. Security automation, AI glue, and anything boring and repetitive.",
        url: "https://python.org",
      },
      {
        name: "Home Assistant",
        description: "Lights, sensors, and a pile of automations.",
        url: "https://home-assistant.io",
      },
      {
        name: "Immich",
        description: "Photo library I host for family and friends.",
        url: "https://immich.app",
      },
    ],
  },
  {
    title: "AI & ML",
    items: [
      {
        name: "Foundation Models",
        description:
          "Trying models and wiring them into real workflows, not just demos.",
        url: "https://huggingface.co",
      },
      {
        name: "Retrieval Architectures",
        description:
          "Getting the right context in front of a model. Reranking, query tweaks, and retrieval that is not always a vector database.",
      },
      {
        name: "MLOps Pipelines",
        description:
          "Eval, versioning, deploys, and a way to roll back when a prompt change makes things worse.",
      },
      {
        name: "Self-hosted Inference",
        description:
          "Local models on the homelab GPU, mostly so I can experiment without sending everything out.",
      },
    ],
  },
  {
    title: "Cloud & DevOps stack",
    items: [
      {
        name: "Kubernetes (K3s)",
        description: "The cluster in the rack. Apps ship as Helm charts.",
        url: "https://kubernetes.io",
      },
      {
        name: "Helm + FluxCD",
        description:
          "Git says what should be running. Flux makes the cluster match.",
        url: "https://fluxcd.io",
      },
      {
        name: "Docker",
        description: "Building images and running things locally.",
        url: "https://www.docker.com",
      },
      {
        name: "Zscaler (ZIA / ZPA / ZDX)",
        description:
          "I ran this stack for about four years. I still help with it.",
        url: "https://www.zscaler.com",
      },
      {
        name: "PostgreSQL + Redis",
        description: "Databases and cache for stuff on the homelab.",
      },
    ],
  },
  {
    title: "Workflow",
    items: [
      {
        name: "GitOps with FluxCD",
        description:
          "A merge deploys it. I try not to kubectl apply in production.",
      },
      {
        name: "Validation gates in CI",
        description:
          "Changes get checked, reviewed, and a rollback path before they go out.",
      },
      {
        name: "Segregated dev and prod",
        description:
          "Dev and prod are separate, and the prod config is encrypted.",
      },
      {
        name: "Runbooks for everything",
        description: "If I do it by hand twice, I write it down.",
      },
    ],
  },
];
---

<BaseLayout
  title="Uses"
  description="The hardware, software, and habits I actually use."
>
  <div class="container-page py-10 sm:py-14">
    <header>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Uses</h1>
      <p class="mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
        The hardware, software, and habits I actually use. Format borrowed from
        <a
          href="https://uses.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent underline decoration-accent/40 underline-offset-3 hover:decoration-accent"
          >uses.tech</a
        >.
      </p>
    </header>

    <div class="mt-10 space-y-12" data-pagefind-body>
      {
        sections.map((section) => (
          <section>
            <h2 class="mb-4 text-lg font-semibold tracking-tight">
              {section.title}
            </h2>
            <ul class="divide-y divide-border/60 rounded-xl border border-border bg-card/60">
              {section.items.map((item) => (
                <li class="flex items-start justify-between gap-4 px-5 py-3.5">
                  <div class="min-w-0">
                    <p class="text-sm font-medium">
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 transition-colors hover:text-accent"
                        >
                          {item.name}
                          <Icon
                            name="external-link"
                            size={12}
                            class="text-muted-foreground"
                          />
                        </a>
                      ) : (
                        item.name
                      )}
                    </p>
                    <p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">
                      {item.description}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
