---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { experience, education, certifications } from '@/config/resume';
import { getProjects } from '@/lib/content';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { url } from '@/lib/utils';

const { author } = siteConfig;
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout title="Resume" description={`Resume of ${author.name}, ${author.role}.`}>
  <div class="container-page py-10 sm:py-14">
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Resume</h1>
      <div class="flex gap-2.5">
        <Button size="sm" id="print-resume">
          <Icon name="download" size={13} />
          Download PDF
        </Button>
        {
          siteConfig.resume.pdfFile && (
            <Button href={url(siteConfig.resume.pdfFile)} variant="secondary" size="sm" download>
              <Icon name="file-text" size={13} />
              Download file
            </Button>
          )
        }
      </div>
    </div>

    {/* Profile */}
    <section class="border-b border-border/60 pb-8">
      <h2 class="text-2xl font-semibold tracking-tight">{author.name}</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        {author.role} · {author.location} · {author.email}
      </p>
      <p class="mt-4 max-w-xl text-sm leading-relaxed">
        Senior Cybersecurity Engineer with over 7 years of experience securing enterprise
        environments at scale, including 4 years engineering Zscaler environments for 250,000
        global users in 24x7 production. I drive secure access modernization through Zero Trust
        architecture and automation, design CI/CD workflows for multi-tenant SASE and SWG
        deployments, and architect on-premises and cloud-native solutions. My focus is enabling
        organizations to enhance security, streamline operations, and accelerate digital
        transformation.
      </p>
    </section>

    {/* Experience */}
    <section class="mt-8">
      <h2 class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">
        Experience
      </h2>
      <div class="mt-4 space-y-6">
        {
          experience.map((job) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6">
                <h3 class="font-semibold tracking-tight">
                  {job.position} · <span class="text-muted-foreground">{job.company}</span>
                </h3>
                <p class="text-xs text-muted-foreground">
                  {job.start} – {job.end ?? 'Present'}
                </p>
              </div>
              <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-foreground/85">
                {job.description}
              </p>
              <p class="mt-1.5 font-mono text-xs text-muted-foreground">
                {job.technologies.join(' · ')}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    {/* Education */}
    <section class="mt-8 border-t border-border/60 pt-8">
      <h2 class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">
        Education
      </h2>
      <div class="mt-4 space-y-4">
        {
          education.map((item) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6">
              <div>
                <h3 class="font-semibold tracking-tight">{item.degree}</h3>
                <p class="text-sm text-muted-foreground">{item.institution}</p>
                {item.description && (
                  <p class="mt-1 text-sm text-foreground/85">{item.description}</p>
                )}
              </div>
              <p class="text-xs text-muted-foreground">
                {item.start} – {item.end}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    {/* Skills */}
    <section class="mt-8 border-t border-border/60 pt-8">
      <h2 class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">Skills</h2>
      <div class="mt-4 space-y-2">
        {
          siteConfig.skills.map(({ category, items }) => (
            <p class="text-sm">
              <span class="font-medium">{category}:</span>
              <span class="text-muted-foreground"> {items.join(', ')}</span>
            </p>
          ))
        }
      </div>
    </section>

    {/* Selected projects */}
    {
      projects.length > 0 && (
        <section class="mt-8 border-t border-border/60 pt-8">
          <h2 class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">
            Selected projects
          </h2>
          <div class="mt-4 space-y-4">
            {projects.map((project) => (
              <div>
                <h3 class="font-semibold tracking-tight">{project.data.title}</h3>
                <p class="mt-0.5 max-w-xl text-sm leading-relaxed text-foreground/85">
                  {project.data.description}
                </p>
                <p class="mt-1 font-mono text-xs text-muted-foreground">
                  {project.data.technologies.join(' · ')}
                </p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/* Certifications */}
    {
      certifications.length > 0 && (
        <section class="mt-8 border-t border-border/60 pt-8">
          <h2 class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">
            Certifications
          </h2>
          <ul class="mt-4 space-y-2">
            {certifications.map((cert) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-6 text-sm">
                <span class="font-medium">{cert.name}</span>
                <span class="text-xs text-muted-foreground">
                  {cert.issuer} · {cert.year}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  document.getElementById('print-resume')?.addEventListener('click', () => window.print());
</script>
