---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { personSchema } from '@/lib/seo';
import { url } from '@/lib/utils';
import { getFeaturedPosts, getFeaturedProjects } from '@/lib/content';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Section from '@/components/ui/Section.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import SocialLinks from '@/components/layout/SocialLinks.astro';
import ContributionGraph from '@/components/home/ContributionGraph.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import Icon from '@/components/ui/Icon.astro';

const projects = siteConfig.features.projects ? await getFeaturedProjects(4) : [];
const posts = siteConfig.features.blog ? await getFeaturedPosts(4) : [];
const { author, hero } = siteConfig;
---

<BaseLayout jsonLd={[personSchema()]}>
  <div class="container-page">
    {/* ------------------------------ Hero ------------------------------ */}
    <section class="pt-14 sm:pt-20">
      <div class="flex items-center gap-5">
        <img
          src={url(author.avatar)}
          alt={`Portrait of ${author.name}`}
          width="80"
          height="80"
          class="size-16 rounded-full border border-border bg-muted ring-2 ring-accent/25 ring-offset-2 ring-offset-background sm:size-20"
        />
        <div class="min-w-0">
          <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{author.name}</h1>
          <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
            <span>{author.role}</span>
            <span aria-hidden="true" class="opacity-50">·</span>
            <span>{author.location}</span>
            <span aria-hidden="true" class="hidden opacity-50 sm:inline">·</span>
            <span class="hidden items-center gap-0.5 sm:inline-flex">
              {author.email}
              <CopyButton text={author.email} label="Copy email address" />
            </span>
          </p>
        </div>
      </div>

      {
        hero.status && (
          <div class="mt-6">
            <Badge variant="success" dot>
              {hero.status}
            </Badge>
          </div>
        )
      }

      <p class="mt-5 max-w-xl text-lg leading-relaxed text-balance">
        {hero.tagline}
      </p>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">
        {hero.intro}
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <Button href={url(hero.primaryCta.href)}>
          {hero.primaryCta.label}
          <Icon name="arrow-right" size={14} />
        </Button>
        <Button href={url(hero.secondaryCta.href)} variant="secondary">
          {hero.secondaryCta.label}
        </Button>
      </div>

      <SocialLinks class="mt-6 -ml-2" withRss />
    </section>

    {/* ----------------------- GitHub activity -------------------------- */}
    {
      siteConfig.features.githubActivity && (
        <Section title="GitHub activity" href={`https://github.com/${siteConfig.github.username}`} linkLabel="View profile">
          <div class="rounded-xl border border-border bg-card/60 p-5">
            <ContributionGraph />
          </div>
        </Section>
      )
    }

    {/* ---------------------- Featured projects ------------------------- */}
    {
      siteConfig.features.projects && projects.length > 0 && (
        <Section title="Featured projects" href="/projects">
          <div class="grid gap-4 sm:grid-cols-2">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </Section>
      )
    }

    {/* ----------------------- Latest articles -------------------------- */}
    {
      siteConfig.features.blog && posts.length > 0 && (
        <Section title="Latest articles" href="/blog">
          <div class="flex flex-col">
            {posts.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
        </Section>
      )
    }

    {/* --------------------------- Stats -------------------------------- */}
    {
      siteConfig.stats.length > 0 && (
        <Section title="By the numbers">
          <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            {siteConfig.stats.map((stat) => (
              <div class="rounded-xl border border-border bg-card/60 p-4">
                <dd class="text-2xl font-semibold tracking-tight">{stat.value}</dd>
                <dt class="mt-1 text-xs text-muted-foreground">{stat.label}</dt>
              </div>
            ))}
          </dl>
        </Section>
      )
    }

    {/* --------------------------- Skills ------------------------------- */}
    {
      siteConfig.skills.length > 0 && (
        <Section title="Skills & technologies">
          <div class="space-y-5">
            {siteConfig.skills.map(({ category, items }) => (
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline">
                <p class="w-32 shrink-0 text-xs font-medium tracking-wide text-muted-foreground uppercase">
                  {category}
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {items.map((skill) => (
                    <span class="rounded-md border border-border bg-card px-2.5 py-1 font-mono text-xs text-foreground/90">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </Section>
      )
    }

    {/* ---------------------------- CTA ---------------------------------- */}
    <section class="mt-16 sm:mt-20">
      <div class="rounded-2xl border border-border bg-card/60 p-8 text-center sm:p-10">
        <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">Let's build something</h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">
          I'm open to interesting projects, collaborations, and consulting. The fastest way to
          reach me is email — or explore my work first.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <Button href={`mailto:${author.email}`}>
            <Icon name="mail" size={14} />
            Get in touch
          </Button>
          <Button href={url('/projects')} variant="secondary">View projects</Button>
          <Button href={url('/blog')} variant="ghost">Read the blog</Button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
