---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { personSchema } from "@/lib/seo";
import { url } from "@/lib/utils";
import { getPosts, getProjects, getRecentProjects } from "@/lib/content";
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import CopyButton from "@/components/ui/CopyButton.astro";
import SocialLinks from "@/components/layout/SocialLinks.astro";
import ContributionGraph from "@/components/home/ContributionGraph.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import ArticleCard from "@/components/blog/ArticleCard.astro";
import Icon from "@/components/ui/Icon.astro";

const allProjects = siteConfig.features.projects ? await getProjects() : [];
const featuredProjects = allProjects.filter((project) => project.data.featured);
const recentProjects = siteConfig.features.projects
  ? await getRecentProjects(4)
  : [];
const featuredPosts = siteConfig.features.blog
  ? (await getPosts()).filter((post) => post.data.featured)
  : [];
const hasFeatured = featuredProjects.length > 0 || featuredPosts.length > 0;
const { author, hero } = siteConfig;
---

<BaseLayout jsonLd={[personSchema()]}>
  <div class="container-page">
    {/* ------------------------------ Hero ------------------------------ */}
    <section class="pt-14 sm:pt-20">
      <div class="flex items-center gap-5">
        <img
          src={url(author.avatar)}
          alt={`Portrait of ${author.name}`}
          width="80"
          height="80"
          class="size-16 rounded-full border border-border bg-muted ring-2 ring-accent/25 ring-offset-2 ring-offset-background sm:size-20"
        />
        <div class="min-w-0">
          <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
            {author.name}
          </h1>
          <p
            class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground"
          >
            <span>{author.role}</span>
            <span aria-hidden="true" class="opacity-50">·</span>
            <span>{author.location}</span>
            <span aria-hidden="true" class="hidden opacity-50 sm:inline">·</span
            >
            <span class="hidden items-center gap-0.5 sm:inline-flex">
              {author.email}
              <CopyButton text={author.email} label="Copy email address" />
            </span>
          </p>
        </div>
      </div>

      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-balance">
        {hero.tagline}
      </p>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        {hero.intro}
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <Button href={url(hero.primaryCta.href)}>
          {hero.primaryCta.label}
          <Icon name="arrow-right" size={14} />
        </Button>
        <Button href={url(hero.secondaryCta.href)} variant="secondary">
          {hero.secondaryCta.label}
        </Button>
      </div>

      <SocialLinks class="mt-6 -ml-2" withRss />
    </section>

    {
      /* ------------------------------ Featured ------------------------------ */
    }
    {
      hasFeatured && (
        <Section title="Featured">
          {featuredProjects.length > 0 && (
            <div
              class:list={[
                "grid gap-4",
                featuredProjects.length > 1 ? "sm:grid-cols-2" : "max-w-3xl",
              ]}
            >
              {featuredProjects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          )}
          {featuredPosts.length > 0 && (
            <div
              class:list={[
                "flex flex-col",
                featuredProjects.length > 0 && "mt-4",
              ]}
            >
              {featuredPosts.map((post) => (
                <ArticleCard post={post} />
              ))}
            </div>
          )}
        </Section>
      )
    }

    {/* ------------------------- Recent projects ------------------------- */}
    {
      recentProjects.length > 0 && (
        <Section title="Recent projects" href="/projects">
          <div
            class:list={[
              "grid gap-4",
              recentProjects.length > 1 ? "sm:grid-cols-2" : "max-w-3xl",
            ]}
          >
            {recentProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </Section>
      )
    }

    {/* ----------------------- GitHub activity -------------------------- */}
    {
      siteConfig.features.githubActivity && (
        <Section
          title="GitHub activity"
          href={`https://github.com/${siteConfig.github.username}`}
          linkLabel="View profile"
        >
          <div class="rounded-xl border border-border bg-card/60 p-5">
            <ContributionGraph />
          </div>
        </Section>
      )
    }

    {/* ---------------------------- CTA ---------------------------------- */}
    <section class="mt-16 sm:mt-20">
      <div
        class="rounded-2xl border border-border bg-card/60 p-8 text-center sm:p-10"
      >
        <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">
          Want to talk?
        </h2>
        <p
          class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted-foreground"
        >
          Email is the easiest way to reach me. Or look through the projects
          first if you want to see what I have been building.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <Button href={`mailto:${author.email}`}>
            <Icon name="mail" size={14} />
            Email me
          </Button>
          <Button href={url("/projects")} variant="secondary"
            >View projects</Button
          >
          <Button href={url("/blog")} variant="ghost">Read the blog</Button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
