---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
---

<BaseLayout title="Search" description="Search articles, projects, and documentation." noindex>
  <div class="container-page py-10 sm:py-14">
    <header>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Search</h1>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">
        Search across articles, projects, and documentation.
      </p>
    </header>

    <div class="mt-8 flex items-center gap-3 rounded-xl border border-border bg-card px-4 focus-within:border-accent">
      <Icon name="search" size={16} class="shrink-0 text-muted-foreground" />
      <input
        id="page-search-input"
        type="search"
        placeholder="Type to search..."
        autocomplete="off"
        spellcheck="false"
        class="h-12 w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground"
        aria-label="Search the site"
      />
    </div>

    <p id="page-search-status" class="mt-6 text-sm text-muted-foreground">
      Start typing to see results.
    </p>

    <ul id="page-search-results" class="mt-4 flex flex-col gap-2"></ul>
  </div>
</BaseLayout>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }
  interface PagefindResult {
    data: () => Promise<PagefindResultData>;
  }
  interface Pagefind {
    init?: () => Promise<void>;
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  }

  async function initPageSearch() {
    const input = document.getElementById('page-search-input') as HTMLInputElement | null;
    const list = document.getElementById('page-search-results');
    const status = document.getElementById('page-search-status');
    if (!input || !list || !status) return;

    let pagefind: Pagefind | null = null;
    let token = 0;

    async function load(): Promise<Pagefind | null> {
      if (pagefind) return pagefind;
      try {
        const pagefindUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind.js`;
        pagefind = (await import(/* @vite-ignore */ pagefindUrl)) as Pagefind;
        await pagefind.init?.();
        return pagefind;
      } catch {
        status!.textContent = 'Search index not found. It is generated when the site is built.';
        return null;
      }
    }

    async function run(query: string) {
      const current = ++token;
      if (!query.trim()) {
        list!.innerHTML = '';
        status!.textContent = 'Start typing to see results.';
        return;
      }
      const pf = await load();
      if (!pf || current !== token) return;

      const { results } = await pf.search(query);
      if (current !== token) return;

      if (results.length === 0) {
        list!.innerHTML = '';
        status!.textContent = `No results for “${query}”.`;
        return;
      }

      status!.textContent = `${results.length} result${results.length === 1 ? '' : 's'} for “${query}”`;
      const data = await Promise.all(results.slice(0, 20).map((r) => r.data()));
      if (current !== token) return;

      list!.innerHTML = '';
      for (const item of data) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = item.url;
        a.className =
          'block rounded-xl border border-border bg-card/60 px-5 py-4 transition-colors hover:border-muted-foreground/30 hover:bg-card';

        const title = document.createElement('span');
        title.className = 'block text-sm font-medium';
        title.textContent = item.meta.title ?? item.url;

        const url = document.createElement('span');
        url.className = 'mt-0.5 block font-mono text-xs text-muted-foreground';
        url.textContent = item.url;

        const excerpt = document.createElement('span');
        excerpt.className =
          'mt-2 block text-sm leading-relaxed text-muted-foreground [&_mark]:bg-transparent [&_mark]:font-semibold [&_mark]:text-accent';
        excerpt.innerHTML = item.excerpt;

        a.append(title, url, excerpt);
        li.appendChild(a);
        list!.appendChild(li);
      }
    }

    let debounce: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => run(input!.value), 200);
    });

    // Support /search?q=... deep links
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      run(initial);
    }
    input.focus();
  }
  initPageSearch();
</script>
