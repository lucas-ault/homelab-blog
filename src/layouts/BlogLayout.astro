---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { siteConfig } from "@/config/site";
import type { Post } from "@/lib/content";
import { formatDate, isoDate, readingTimeMinutes, url } from "@/lib/utils";
import { articleSchema, breadcrumbSchema, absoluteUrl } from "@/lib/seo";
import TagBadge from "@/components/blog/TagBadge.astro";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import ShareButtons from "@/components/blog/ShareButtons.astro";
import AuthorCard from "@/components/blog/AuthorCard.astro";
import ArticleCard from "@/components/blog/ArticleCard.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev: Post | null;
  next: Post | null;
  related: Post[];
}

const { post, headings, prev, next, related } = Astro.props;
const { data } = post;
const author = data.author ?? siteConfig.author.name;
const minutes = readingTimeMinutes(post.body);
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? siteConfig.url,
).toString();

const jsonLd = [
  articleSchema({
    title: data.title,
    description: data.description,
    url: canonicalUrl,
    image: data.image,
    publishedAt: data.publishedAt,
    updatedAt: data.updatedAt,
    tags: data.tags,
  }),
  breadcrumbSchema([
    { name: "Home", url: absoluteUrl("/") },
    { name: "Blog", url: absoluteUrl("/blog") },
    { name: data.title, url: canonicalUrl },
  ]),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.image}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  jsonLd={jsonLd}
>
  <div class="container-page py-10 sm:py-14">
    <div
      class="lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:items-start lg:gap-12"
    >
      <div class="min-w-0">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog" },
            { label: data.title },
          ]}
        />

        <header>
          {
            data.category && (
              <p class="mb-3 font-mono text-xs font-medium tracking-wide text-accent uppercase">
                {data.category}
              </p>
            )
          }
          <h1
            class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
          >
            {data.title}
          </h1>
          <p
            class="mt-3 text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            {data.description}
          </p>

          <div
            class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground"
          >
            <span class="flex items-center gap-1.5">
              <img
                src={url(siteConfig.author.avatar)}
                alt=""
                width="20"
                height="20"
                class="size-5 rounded-full border border-border bg-muted"
              />
              {author}
            </span>
            <span class="flex items-center gap-1.5">
              <Icon name="calendar" size={13} />
              <time datetime={isoDate(data.publishedAt)}
                >{formatDate(data.publishedAt)}</time
              >
            </span>
            {
              data.updatedAt && (
                <span class="flex items-center gap-1.5">
                  Updated
                  <time datetime={isoDate(data.updatedAt)}>
                    {formatDate(data.updatedAt)}
                  </time>
                </span>
              )
            }
            <span class="flex items-center gap-1.5">
              <Icon name="clock" size={13} />
              {minutes} min read
            </span>
          </div>

          {
            data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {data.tags.map((tag) => (
                  <TagBadge tag={tag} />
                ))}
              </div>
            )
          }

          {
            data.image && (
              <img
                src={url(data.image)}
                alt=""
                width="1400"
                height="740"
                class="mt-8 aspect-[1.9/1] w-full rounded-xl border border-border object-cover"
              />
            )
          }
        </header>

        <div class="mt-8 lg:hidden">
          <TableOfContents headings={headings} variant="mobile" />
        </div>

        <article class="prose mt-8 max-w-[68ch]" data-pagefind-body>
          <slot />
        </article>

        <div
          class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-border/60 pt-6"
        >
          <ShareButtons title={data.title} url={canonicalUrl} />
          <a
            href={url("/blog")}
            class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-accent"
          >
            <Icon name="arrow-left" size={13} />
            All articles
          </a>
        </div>

        <div class="mt-8">
          <AuthorCard name={author} />
        </div>

        {
          (prev || next) && (
            <nav
              class="mt-10 grid gap-4 sm:grid-cols-2"
              aria-label="Article navigation"
            >
              {prev ? (
                <a
                  href={url(`/blog/${prev.id}`)}
                  rel="prev"
                  class="group rounded-xl border border-border bg-card/60 p-4 transition-colors hover:border-muted-foreground/30 hover:bg-card"
                >
                  <span class="flex items-center gap-1 text-xs text-muted-foreground">
                    <Icon name="arrow-left" size={12} />
                    Previous article
                  </span>
                  <span class="mt-1.5 block text-sm font-medium transition-colors group-hover:text-accent">
                    {prev.data.title}
                  </span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a
                  href={url(`/blog/${next.id}`)}
                  rel="next"
                  class="group rounded-xl border border-border bg-card/60 p-4 text-right transition-colors hover:border-muted-foreground/30 hover:bg-card sm:col-start-2"
                >
                  <span class="flex items-center justify-end gap-1 text-xs text-muted-foreground">
                    Next article
                    <Icon name="arrow-right" size={12} />
                  </span>
                  <span class="mt-1.5 block text-sm font-medium transition-colors group-hover:text-accent">
                    {next.data.title}
                  </span>
                </a>
              )}
            </nav>
          )
        }

        {
          related.length > 0 && (
            <section class="mt-12">
              <h2 class="mb-4 text-lg font-semibold tracking-tight">
                Related articles
              </h2>
              <div class="flex flex-col">
                {related.map((relatedPost) => (
                  <ArticleCard post={relatedPost} variant="compact" />
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="sticky top-24 hidden lg:block">
        <TableOfContents headings={headings} variant="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
