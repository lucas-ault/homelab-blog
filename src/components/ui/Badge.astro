---
import { cn } from '@/lib/utils';

interface Props {
  variant?: 'default' | 'outline' | 'accent' | 'success';
  /** Show a small status dot (pulsing for success) */
  dot?: boolean;
  class?: string;
}

const { variant = 'default', dot = false, class: className } = Astro.props;
---

<span
  class={cn(
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium',
    variant === 'default' && 'bg-muted text-muted-foreground',
    variant === 'outline' && 'border border-border text-muted-foreground',
    variant === 'accent' && 'bg-accent/15 text-accent',
    variant === 'success' && 'bg-success/15 text-success',
    className,
  )}
>
  {dot && <span class={variant === 'success' ? 'status-dot' : 'size-2 rounded-full bg-current opacity-60'}></span>}
  <slot />
</span>
