---
import type { Doc } from '@/lib/content';
import { url } from '@/lib/utils';

interface Props {
  groups: Array<{ group: string; items: Doc[] }>;
}

const { groups } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '');
---

<nav aria-label="Documentation" class="space-y-6 text-sm">
  {
    groups.map(({ group, items }) => (
      <div>
        <p class="mb-2 text-xs font-semibold tracking-wide text-foreground uppercase">{group}</p>
        <ul class="space-y-0.5 border-l border-border">
          {items.map((doc) => {
            const href = url(`/docs/${doc.id}`);
            const active = pathname === href;
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    '-ml-px block border-l py-1 pl-4 transition-colors',
                    active
                      ? 'border-accent font-medium text-accent'
                      : 'border-transparent text-muted-foreground hover:border-muted-foreground/40 hover:text-foreground',
                  ]}
                >
                  {doc.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
