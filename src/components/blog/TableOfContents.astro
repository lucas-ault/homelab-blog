---
import type { MarkdownHeading } from 'astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'sidebar' | 'mobile';
}

const { headings, variant = 'sidebar' } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 0 && variant === 'sidebar' && (
    <nav data-toc aria-label="Table of contents" class="text-sm">
      <p class="mb-3 text-xs font-semibold tracking-wide text-foreground uppercase">On this page</p>
      <ul class="space-y-2 border-l border-border">
        {toc.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                '-ml-px block border-l border-transparent py-0.5 text-muted-foreground transition-colors hover:text-foreground aria-[current=true]:border-accent aria-[current=true]:font-medium aria-[current=true]:text-accent',
                heading.depth === 2 ? 'pl-4' : 'pl-7',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  toc.length > 0 && variant === 'mobile' && (
    <details class="group rounded-lg border border-border bg-card xl:hidden">
      <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium select-none">
        On this page
        <Icon name="chevron-down" size={16} class="transition-transform group-open:rotate-180" />
      </summary>
      <ul class="space-y-1.5 border-t border-border px-4 py-3 text-sm">
        {toc.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                'block py-0.5 text-muted-foreground transition-colors hover:text-foreground',
                heading.depth === 3 && 'pl-4',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

{
  variant === 'sidebar' && toc.length > 0 && (
    <script>
      function initToc() {
        const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc] a');
        if (tocLinks.length === 0) return;

        const headingEls = Array.from(
          document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]'),
        );
        if (headingEls.length === 0) return;

        const linkById = new Map<string, HTMLAnchorElement>();
        tocLinks.forEach((link) => {
          linkById.set(decodeURIComponent(link.hash.slice(1)), link);
        });

        let activeId: string | null = null;
        function setActive(id: string) {
          if (id === activeId) return;
          activeId = id;
          tocLinks.forEach((link) => link.removeAttribute('aria-current'));
          linkById.get(id)?.setAttribute('aria-current', 'true');
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                setActive(entry.target.id);
                break;
              }
            }
          },
          { rootMargin: '-72px 0px -75% 0px', threshold: 0 },
        );
        headingEls.forEach((el) => observer.observe(el));
      }
      initToc();
    </script>
  )
}
