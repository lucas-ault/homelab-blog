---
import { siteConfig } from '@/config/site';
import { url } from '@/lib/utils';
import SocialLinks from '@/components/layout/SocialLinks.astro';

interface Props {
  /** Override the author name (defaults to the site author) */
  name?: string;
}

const { name = siteConfig.author.name } = Astro.props;
const isSiteAuthor = name === siteConfig.author.name;
---

<div class="flex items-center justify-between gap-4 rounded-xl border border-border bg-card/60 p-4">
  <div class="flex items-center gap-3">
    <img
      src={url(siteConfig.author.avatar)}
      alt=""
      width="40"
      height="40"
      loading="lazy"
      class="size-10 rounded-full border border-border bg-muted"
    />
    <div>
      <p class="text-sm font-medium">{name}</p>
      {isSiteAuthor && <p class="text-xs text-muted-foreground">{siteConfig.author.role}</p>}
    </div>
  </div>
  {isSiteAuthor && <SocialLinks size={14} />}
</div>
