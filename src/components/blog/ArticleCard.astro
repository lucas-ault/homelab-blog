---
import type { Post } from '@/lib/content';
import { formatDate, isoDate, readingTimeMinutes, url } from '@/lib/utils';
import TagBadge from './TagBadge.astro';

interface Props {
  post: Post;
  /** 'row' — minimal list item; 'compact' — title + date only */
  variant?: 'row' | 'compact';
}

const { post, variant = 'row' } = Astro.props;
const href = url(`/blog/${post.id}`);
const minutes = readingTimeMinutes(post.body);
---

{
  variant === 'compact' ? (
    <article class="group relative -mx-3 flex items-baseline justify-between gap-6 rounded-lg px-3 py-2 transition-colors hover:bg-muted/60">
      <h3 class="text-sm font-medium">
        <a href={href} class="after:absolute after:inset-0 group-hover:text-accent">
          {post.data.title}
        </a>
      </h3>
      <time datetime={isoDate(post.data.publishedAt)} class="shrink-0 text-xs text-muted-foreground">
        {formatDate(post.data.publishedAt)}
      </time>
    </article>
  ) : (
    <article class="group relative -mx-4 rounded-xl px-4 py-4 transition-colors hover:bg-muted/60">
      <div class="flex items-start justify-between gap-6">
        <div class="min-w-0">
          <h3 class="font-medium tracking-tight text-balance">
            <a href={href} class="after:absolute after:inset-0 transition-colors group-hover:text-accent">
              {post.data.title}
            </a>
          </h3>
          <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
            {post.data.description}
          </p>
          {post.data.tags.length > 0 && (
            <div class="relative z-10 mt-3 flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 4).map((tag) => (
                <TagBadge tag={tag} />
              ))}
            </div>
          )}
        </div>
        <div class="shrink-0 text-right text-xs text-muted-foreground">
          <time datetime={isoDate(post.data.publishedAt)} class="block">
            {formatDate(post.data.publishedAt)}
          </time>
          <span class="mt-1 block opacity-75">{minutes} min read</span>
        </div>
      </div>
    </article>
  )
}
