---
import type { CertificationItem } from "@/config/resume";
import { url } from "@/lib/utils";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  cert: CertificationItem;
}

const { cert } = Astro.props;

const initials = cert.issuer
  .split(" ")
  .map((word) => word[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<div
  class="group flex items-start gap-4 rounded-xl border border-border bg-card/60 p-4 transition-colors hover:border-muted-foreground/30 hover:bg-card"
>
  {
    cert.logo ? (
      <img
        src={url(cert.logo)}
        alt={`${cert.issuer} logo`}
        width="40"
        height="40"
        loading="lazy"
        class="size-10 shrink-0 rounded-lg object-contain"
      />
    ) : (
      <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted font-mono text-sm font-semibold text-muted-foreground">
        {initials}
      </div>
    )
  }

  <div class="min-w-0 flex-1">
    <h3 class="text-sm font-semibold leading-snug tracking-tight">
      {cert.name}
    </h3>
    <p class="mt-0.5 text-xs text-muted-foreground">{cert.issuer}</p>

    {
      (cert.issuedDate || cert.expirationDate) && (
        <p class="mt-2 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-xs text-muted-foreground">
          {cert.issuedDate && <span>Issued {cert.issuedDate}</span>}
          {cert.issuedDate && cert.expirationDate && (
            <span aria-hidden="true" class="opacity-50">
              ·
            </span>
          )}
          {cert.expirationDate ? (
            <span>Expires {cert.expirationDate}</span>
          ) : (
            cert.issuedDate && <span>No expiration</span>
          )}
        </p>
      )
    }

    {
      (cert.credentialId || cert.url) && (
        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
          {cert.credentialId && (
            <span class="font-mono text-muted-foreground">
              ID: {cert.credentialId}
            </span>
          )}
          {cert.url && (
            <a
              href={cert.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-accent transition-colors hover:underline"
            >
              <Icon name="external-link" size={12} />
              Verify
            </a>
          )}
        </div>
      )
    }
  </div>
</div>
